# =============================================================================
# MangaDex Application Environment Configuration
# Copy this file to .env and adjust variables to customize pipeline execution.
# All paths default to the local isolated './output/' directory.
# =============================================================================

# --- Storage & Artifact Output Paths ---
MANGADEX_JOBS_PATH=./configs/jobs.yaml
MANGADEX_DB_PATH=./output/mangadex.db
MANGADEX_SCHEMA_PATH=./configs/schemas.yaml
CBZ_STAGING_DIR=./output/cbz/

# --- Komga Host & REST API / Remote SSH ---
KOMGA_HOST=192.168.1.10
KOMGA_URL=http://${KOMGA_HOST}:25600
KOMGA_API_KEY=e94c35e655c74d1ab97449f255eece41
# Alternative Basic Auth (used if KOMGA_API_KEY is unset):
# KOMGA_USERNAME=admin@komga.org
# KOMGA_PASSWORD=your_komga_password

# --- Komga Remote SSH Upload (ssh_store datasource) ---
KOMGA_SSH_HOST=server
#KOMGA_SSH_PORT=22
#KOMGA_SSH_USER=ubuntu
#KOMGA_SSH_KEY=~/.ssh/server
KOMGA_SSH_DIR=/home/ubuntu/komga/media
KOMGA_DEFAULT_LIBRARY=manga

# --- Observability, Logs & Telemetry ---
FLOWDATA_TRACE_OUT=./output/logs/trace.jsonl
OTEL_EXPORTER_FILE_PATH=./output/logs/otel_export.json
OTEL_SERVICE_NAME=manga-sync

# --- Global Service URLs ---
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_AUTH_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect/token

# --- Authentication Strategy 1: Pre-acquired Static JWT Token ---
# If set, StaticTokenAuth is automatically chosen.
# MANGADEX_ACCESS_TOKEN=eyJhbGciOi...
# MANGADEX_TOKEN=eyJhbGciOi...

# --- Authentication Strategy 2: Personal Client (OIDC Password Grant) ---
# Required if personal client credentials are used:
MANGADEX_CLIENT_ID=personal-client-c5293333-a698-4278-8167-07b224406f95-d0db5a25
MANGADEX_CLIENT_SECRET=nvGskFwwbJuf83HjbBXCoHG8eWr5nax4
# MANGADEX_USERNAME=my_mangadex_user
# MANGADEX_PASSWORD=my_secure_password

# --- Strategy 3: Anonymous Mode ---
# Leave all auth variables unset or commented to access public endpoints anonymously.
